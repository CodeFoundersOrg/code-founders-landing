---
import BlurLayout from '../layouts/blur.astro';
import Opleiding from '../components/opleiding.astro';
import { inDir, opleidingSlug } from '../utils/content.js';

const opleidingen = inDir('opleiding-items').filter(opleiding => !opleiding.draft);
const [content] = inDir('opleidingen');
---
<style>
  .opleidingen {
    display: grid;
    max-width: var(--page-max-width);
    grid-template-columns: repeat(auto-fill,min(100%, 485px));
    justify-items: center;
    justify-content: center;
    gap: 5rem;
    margin: 0 auto 10rem auto;
  }

  .link {
    text-decoration: none;
    color: white;
  }
</style>
<BlurLayout subtitle={content.description} heading={content.heading}>
<link slot="head" rel="stylesheet" href="/style/opleidingen.css" />
<div class="opleidingen">
  {opleidingen.map(opleiding =>
    <a class="link" href={`/opleidingen/${opleidingSlug(opleiding)}`}>
      <Opleiding content={opleiding} class="opleiding"></Opleiding>
    </a>
  )}
</div>
</BlurLayout>